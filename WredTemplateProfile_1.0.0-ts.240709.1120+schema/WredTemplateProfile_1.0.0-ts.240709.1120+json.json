  "/profile-collection/profile={uuid}/wred-template-profile-pac/wred-template-profile-capability": {
      "type": "object",
      "required": [
          "wred-template-profile-1-0:wred-template-profile-capability"
      ],
      "properties": {
          "wred-template-profile-1-0:wred-template-profile-capability": {
              "type": "object",
              "required": [
                  "available-buffer-size",
                  "drop-probability-at-threshold-low-is-avail",
