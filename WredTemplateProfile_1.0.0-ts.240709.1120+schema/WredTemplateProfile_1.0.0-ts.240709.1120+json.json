                  },
                  "coloring-is-avail": {
                      "type": "boolean"
                  },
                  "supported-wred-protocol-list": {
                      "type": "array",
                      "minItems": 0,
                      "items": {
                          "type": "string",
                          "enum": [
                              "wred-template-profile-1-0:PROTOCOL_LAYER_TYPE_NONE",
                              "wred-template-profile-1-0:PROTOCOL_LAYER_TYPE_ETHERNET_MAC",
                              "wred-template-profile-1-0:PROTOCOL_LAYER_TYPE_VLAN",
                              "wred-template-profile-1-0:PROTOCOL_LAYER_TYPE_Q_IN_Q",
                              "wred-template-profile-1-0:PROTOCOL_LAYER_TYPE_MPLS",
                              "wred-template-profile-1-0:PROTOCOL_LAYER_TYPE_IPV4",
                              "wred-template-profile-1-0:PROTOCOL_LAYER_TYPE_IPV6",
                              "wred-template-profile-1-0:PROTOCOL_LAYER_TYPE_TCP",
                              "wred-template-profile-1-0:PROTOCOL_LAYER_TYPE_UDP",
                              "wred-template-profile-1-0:PROTOCOL_LAYER_TYPE_RTP",
                              "wred-template-profile-1-0:PROTOCOL_LAYER_TYPE_GTP_U",
                              "wred-template-profile-1-0:PROTOCOL_LAYER_TYPE_OTHERS",
                              "wred-template-profile-1-0:PROTOCOL_LAYER_TYPE_NOT_YET_DEFINED"
                          ]
                      }
                  },
                  "available-drop-precedence-kind-list": {
                      "type": "array",
                      "minItems": 0,
                      "items": {
                          "type": "string",
                          "enum": [
                              "wred-template-profile-1-0:DROP_PRECEDENCE_TYPE_ALL",
                              "wred-template-profile-1-0:DROP_PRECEDENCE_TYPE_LOW",
                              "wred-template-profile-1-0:DROP_PRECEDENCE_TYPE_MEDIUM",
                              "wred-template-profile-1-0:DROP_PRECEDENCE_TYPE_HIGH",
