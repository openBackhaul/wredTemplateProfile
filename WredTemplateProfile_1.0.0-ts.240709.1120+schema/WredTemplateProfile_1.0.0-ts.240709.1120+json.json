                  "sensitivity-setting-is-avail",
                  "coloring-is-avail"
              ],
              "properties": {
                  "available-buffer-size": {
                      "type": "integer",
                      "format": "int32"
                  },
                  "drop-probability-at-threshold-low-is-avail": {
