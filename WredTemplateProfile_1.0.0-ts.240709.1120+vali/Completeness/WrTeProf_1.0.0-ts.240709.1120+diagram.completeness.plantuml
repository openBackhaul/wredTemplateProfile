@startuml WrTeProf_1.0.0-ts.240709.1120+diagram.completeness
skinparam responseMessageBelowArrow true

title
WredTemplateProfile_1.0.0-ts.240709.1120+diagram.completeness
end title

participant "Postman" as Postman
participant "Collection" as Collection
participant "/control-construct?fields=..." as ListOfLTPUuidAndLidPairsAndNames
participant "/ethernet-container-capability" as EthernetContainerCapability
participant "../profile-collection" as ProfileCollection
participant "../wred-template-profile-capability" as Capability
participant "../wred-template-profile-configuration" as Configuration
participant "../create-wred-template-profile" as CreateRpc
participant "../add-or-modify-wred-profile" as AddRpc
participant "../delete-wred-profile" as RemoveRpc
participant "../delete-wred-template-profile" as DeleteRpc

activate Postman

group Preparation
  Postman --\\o Collection : mountName

  Postman -> ListOfLTPUuidAndLidPairsAndNames : {mountName}
  Postman <-- ListOfLTPUuidAndLidPairsAndNames : {(uuid, localId, layerProtocolName)}
  note right Postman
    selection of EthernetContainer
  end note
  Postman --\\o Collection : {ethernetContainerUuidAndLocalId}

  Collection --\\o Postman : {ethernetContainerUuidAndLocalId}
  Postman -> EthernetContainerCapability : {ethernetContainerUuidAndLocalId}
  Postman <-- EthernetContainerCapability : {wredTemplateProfileIsAvail, wredTemplateProfileConfigurationIsAvail}
  Postman --\\o Collection : wredTemplateProfileIsAvail,\n wredTemplateProfileConfigurationIsAvail

  Collection --\\o Postman : {wredTemplateProfileIsAvail}
  Postman -> ProfileCollection
  Postman <-- ProfileCollection : {(uuid, profileName)}
  note right Postman
    filter for
    WredTemplateProfile
  end note
  Postman --\\o Collection : wredTemplateProfileUuid
end

group Capability Validation
  Collection --\\o Postman : wredTemplateProfileUuid
  Postman -> Capability : {wredTemplateProfileUuid}
  Postman <-- Capability : {wredTemplateProfileCapability}
  note right Postman
    schema validation
  end note
  Postman --\\o Collection : wredTemplateProfileCapability
end

group Configuration Validation
  Collection --\\o Postman : wredTemplateProfileUuid
  Postman -> Configuration : {wredTemplateProfileUuid}
  Postman <-- Configuration : {configuration}
  note right Postman
    schema validation
  end note
  Postman --\\o Collection : wredTemplateProfileConfiguration
end

group Create RPC
  Collection --\\o Postman : wredTemplateProfileIsAvail
  Postman -> CreateRpc
  Postman <-- CreateRpc : {createdWredTemplateProfileUuid}
  note right Postman
    schema validation
  end note
  Postman --\\o Collection : createdWredTemplateProfileUuid
end

group Add or Modify RPC
  Collection --\\o Postman : wredTemplateProfileConfigurationIsAvail,\n createdWredTemplateProfileUuid,\n WredTemplateProfileCapability,\n wredTemplateProfileConfiguration
  Postman -> AddRpc : {wredTemplateProfileToBeModified=createdWredTemplateProfileUuid, affectedProtocol, affectedDropPrecedence, modificationInput}
  Postman <-- AddRpc : 204
  note right Postman
    response==204?
  end note
  Postman --\\o Collection : modificationInput
  Collection --\\o Postman : createdWredTemplateProfileUuid,\n wredTemplateProfileCapability,\n modificationInput
  Postman -> Configuration : {createdWredTemplateProfileUuid}
  Postman <-- Configuration : {readConfiguration}
  note right Postman
    readConfiguration==modificationInput?
  end note
end

group Delete WRED RPC
  Collection --\\o Postman : wredTemplateProfileConfigurationIsAvail,\n createdWredTemplateProfileUuid,\n wredTemplateProfileConfiguration
  Postman -> RemoveRpc : {wredTemplateProfileToBeModified=createdWredTemplateProfileUuid, affectedProtocol, affectedDropPrecedence}
  Postman <-- RemoveRpc : 204
  note right Postman
    response==204?
  end note
end

group Delete WRED Template RPC
  Collection --\\o Postman : createdWredTemplateProfileUuid
  Postman -> DeleteRpc : {obsoleteWredTemplateProfile=createdWredTemplateProfileUuid}
  Postman <-- DeleteRpc : 204
  note right Postman
    response==204?
  end note
end

deactivate Postman

@enduml